# NODIV V2 MINI-PC LAB - TEST ONLY
NODIV_HOST=127.0.0.1
NODIV_PORT=8787
NODIV_DB_PATH=./data/nodiv-v2-test.sqlite
NODIV_TEST_EVENT=TEST-V2
NODIV_SESSION_TTL=3600
NODIV_GRANT_TTL=90
NODIV_EXCHANGE_TTL=300

# Reale NFC-Seriennummern fuer den Schreibtischtest, ohne : oder -.
# Erst nach Lesen der Test-Tags eintragen. Keine V1-Produktivzuordnungen verwenden.
NODIV_UID_ACCESS_CARD=TESTACCESS9003
NODIV_UID_NODE=TESTNODE001
NODIV_UID_PIONEER_CORE=TESTCOREP001
NODIV_UID_NODE_CORE_1=TESTCOREN001
NODIV_UID_NODE_CORE_2=TESTCOREN002
NODIV_UID_NODE_CORE_3=TESTCOREN003

# Optional: Server selbst mit HTTPS betreiben. Schneller fuer den Ersttest ist Tailscale Serve.
NODIV_TLS_KEY=
NODIV_TLS_CERT=
