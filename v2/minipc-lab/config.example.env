# NODIV V2 BLOCK 06 REALTEST - ISOLIERT
NODIV_LAB_MODE=registration
NODIV_HOST=127.0.0.1
NODIV_PORT=8787
NODIV_DB_PATH=./data/nodiv-v2-registration.sqlite
NODIV_TEST_EVENT=BLOCK06-REALTEST
NODIV_SESSION_TTL=3600
NODIV_GRANT_TTL=90
NODIV_EXCHANGE_TTL=300

# Einziger Bootstrap-Wert: reale Founder Access Card.
# Wird ueber Starter -> "Founder Access Card einrichten" geschrieben.
# Keine erfundenen UIDs und keine N-Core-E-Werte hier eintragen.
NODIV_UID_FOUNDER_CARD=

# Optional: Server selbst mit HTTPS betreiben. Fuer den Smartphone-Test wird
# standardmaessig Tailscale Serve vor dem lokalen HTTP-Port verwendet.
NODIV_TLS_KEY=
NODIV_TLS_CERT=

# Separate Quelle fuer den spaeteren repraesentativen EVAC-Teststand.
NODIV_SOURCE_DB_PATH=./data/nodiv-v2-registration.sqlite
