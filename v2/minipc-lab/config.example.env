# NODIV V2 BLOCK 07 - SPIELBARER SCHREIBTISCH-TESTMODUS
NODIV_LAB_MODE=desktop
NODIV_HOST=127.0.0.1
NODIV_PORT=8787
NODIV_DB_PATH=./data/nodiv-v2-desktop.sqlite
NODIV_TEST_EVENT=DESKTOP-TEST
NODIV_SESSION_TTL=3600
NODIV_GRANT_TTL=90
NODIV_EXCHANGE_TTL=300

# Einziger Bootstrap-Wert: reale Founder Access Card.
# Wird ueber NODIV-V2-SPIELEN.cmd -> Founder Access Card einrichten geschrieben.
# Keine Spieler-, Node-, N-Core- oder HQ-UIDs und keine Energie werden vorgegeben.
NODIV_UID_FOUNDER_CARD=

# Optional: Server selbst mit HTTPS betreiben. Fuer Android Web NFC wird
# standardmaessig Tailscale Serve vor dem lokalen HTTP-Port verwendet.
NODIV_TLS_KEY=
NODIV_TLS_CERT=
